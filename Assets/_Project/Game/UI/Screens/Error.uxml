<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="screen page">
        <ui:VisualElement class="error-box card">
            <ui:Label text="@error.questions" class="error-text t-strong" />
            <ui:Button name="retry" class="rematch"><ui:Label text="@error.retry" /></ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
